{
  "expo": {
    "name": "Délice Express",
    "slug": "delice-express",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#fff9f1"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.deliceexpress.app"
    },
    "android": {
      "package": "com.deliceexpress.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Délice Express",
      "description": "Shawarmas, popcorn et glaces à Yaoundé. Commandez facilement sur WhatsApp."
    },
    "plugins": [
      "expo-asset",
      "expo-router"
    ],
    "scheme": "delice"
  }
}